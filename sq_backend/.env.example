# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ── Base de données ───────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/smartqueue

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_unique_256_bit_secret
JWT_REFRESH_SECRET=replace_with_a_unique_256_bit_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Firebase (optionnel pour les notifications push) ──────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Email (optionnel) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
